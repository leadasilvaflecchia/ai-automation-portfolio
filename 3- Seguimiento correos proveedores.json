    {
      "parameters": {
        "jsCode": "const mensajes = $json.messages || [];\nconst emailProveedor = ($json[\"Email proveedor\"] || \"\").toLowerCase().trim();\n\nif (!emailProveedor) {\n  return [{ json: { ...$json, respondio: false } }];\n}\n\nconst respondio = mensajes.some(msg => {\n  const fromRaw = (msg.From || msg.from || \n    msg.payload?.headers?.find(h => h.name === \"From\")?.value || \"\").toLowerCase();\n  return fromRaw.includes(emailProveedor);\n});\n\nreturn [{ json: { ...$json, respondio } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
