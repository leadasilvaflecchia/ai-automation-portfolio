    {
      "parameters": {
        "jsCode": "const ahora = new Date();\nconst filas = $input.all();\n\nconst pendientes24h = [];\nconst pendientes48h = [];\n\nconst parsearFecha = (raw) => {\n  if (!raw) return null;\n  const partes = raw.trim().split(' ');\n  const [dia, mes, anio] = partes[0].split('/');\n  const horaParts = (partes[1] || '00:00').split(':');\n  const hora = horaParts[0].padStart(2, '0');\n  const min = (horaParts[1] || '00').padStart(2, '0');\n  return new Date(`${anio}-${mes}-${dia}T${hora}:${min}:00`);\n};\n\nfor (const item of filas) {\n  const fila = item.json;\n  const estado = fila[\"Estado\"] || \"\";\n  const fechaEnvio = parsearFecha(fila[\"Fecha envío\"]);\n  const fechaRecordatorio1 = parsearFecha(fila[\"Fecha recordatorio 1\"]);\n\n  const horasDesdeEnvio = fechaEnvio ? (ahora - fechaEnvio) / (1000 * 60 * 60) : 0;\n  const horasDesdeRecordatorio1 = fechaRecordatorio1 ? (ahora - fechaRecordatorio1) / (1000 * 60 * 60) : 0;\n\n  if (estado === \"Pendiente\" && horasDesdeEnvio >= 24) {\n    pendientes24h.push({ json: { ...fila, accion: \"recordatorio_1\" } });\n  } else if (estado === \"Recordatorio 1 enviado\" && horasDesdeRecordatorio1 >= 24) {\n    pendientes48h.push({ json: { ...fila, accion: \"recordatorio_2\" } });\n  }\n}\n\nreturn [...pendientes24h, ...pendientes48h];"
      },
