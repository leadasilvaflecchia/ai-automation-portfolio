    {
      "parameters": {
        "jsCode": "const webhook = $('Webhook').first().json.body;\nconst marcaRaw = (webhook[\"Marca\"] || \"\").toString().toLowerCase().trim();\n\nconst resultados = [];\n\nfor (const item of $input.all()) {\n  const proveedor = item.json;\n  \n  const marcasProveedor = (proveedor[\"Marcas\"] || \"\")\n    .toString()\n    .toLowerCase()\n    .split(/[,;]/)\n    .map(m => m.trim().replace(/\\.$/, \"\"))\n    .filter(m => m !== \"\");\n\n  const coincide = marcasProveedor.some(mp => mp.includes(marcaRaw));\n\n  if (marcaRaw !== \"\" && coincide) {\n    resultados.push({\n      json: {\n        ...proveedor,\n        lead_marca: webhook[\"Marca\"],\n        lead_desc: webhook[\"Descripción\"],\n        lead_ref: webhook[\"Referencia\"],\n        lead_user: webhook[\"Responsable\"],\n        lead_cliente: webhook[\"Cliente\"],\n        lead_plazo: webhook[\"Plazo\"],\n        lead_datos_maquina: webhook[\"Datos maquina\"],\n        lead_foto_pieza: webhook[\"Foto pieza\"],\n        lead_foto_maquina: webhook[\"Foto Maquina\"],\n        lead_foto_sin_identificar: webhook[\"Foto sin identificar\"],\n        lead_flete: webhook[\"Flete\"]\n      }\n    });\n  }\n}\n\nreturn resultados;"
      },
