    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const rawOutput = $('Redactor de correos').first().json.content.parts[0].text;\nconst cleaned = rawOutput.replace(/```json\\n?/g, '').replace(/```\\n?/g, '').trim();\nconst cuerpos = JSON.parse(cleaned);\n\nconst idioma = $json[\"Idioma\"] === \"ES\" ? \"es\" : \"en\";\nconst cuerpo = idioma === \"es\" ? cuerpos.cuerpo_es : cuerpos.cuerpo_en;\n\nconst cuerpoLimpio = cuerpo\n  .replace(/\\*\\*(.*?)\\*\\*/g, '$1')\n  .replace(/\\*(.*?)\\*/g, '$1')\n  .replace(/^\\s*[\\*\\-]\\s+/gm, '');\n\nconst contacto = ($json[\"Contacto\"] && $json[\"Contacto\"].trim() !== \"\") \n  ? $json[\"Contacto\"] \n  : $json[\"Proveedor\"];\n\nconst firmas = {\n  \"LD\": \"Leandro Da Silva\",\n  \"SM\": \"Santiago Medaglia\"\n};\nconst nombreFirma = firmas[$json[\"lead_user\"]] || $json[\"lead_user\"];\nconst despedida = idioma === \"es\" ? \"Saludos,\" : \"Kind regards,\";\nconst saludo = idioma === \"es\" ? `Estimado/a ${contacto},` : `Dear ${contacto},`;\n\nconst linksImagenes = [];\nif ($json[\"lead_foto_maquina\"] && $json[\"lead_foto_maquina\"] !== \"Sin imagen\") {\n  linksImagenes.push(idioma === \"es\" \n    ? `<p>Foto máquina: <a href=\"${$json[\"lead_foto_maquina\"]}\">Ver imagen</a></p>`\n    : `<p>Machine photo: <a href=\"${$json[\"lead_foto_maquina\"]}\">View image</a></p>`);\n}\nif ($json[\"lead_foto_pieza\"] && $json[\"lead_foto_pieza\"] !== \"Sin imagen\") {\n  linksImagenes.push(idioma === \"es\"\n    ? `<p>Foto pieza: <a href=\"${$json[\"lead_foto_pieza\"]}\">Ver imagen</a></p>`\n    : `<p>Part photo: <a href=\"${$json[\"lead_foto_pieza\"]}\">View image</a></p>`);\n}\nif ($json[\"lead_foto_sin_identificar\"] && $json[\"lead_foto_sin_identificar\"] !== \"Sin imagen\") {\n  linksImagenes.push(idioma === \"es\"\n    ? `<p>Foto de referencia: <a href=\"${$json[\"lead_foto_sin_identificar\"]}\">Ver imagen</a></p>`\n    : `<p>Reference photo: <a href=\"${$json[\"lead_foto_sin_identificar\"]}\">View image</a></p>`);\n}\n\nconst seccionImagenes = linksImagenes.length > 0 \n  ? `<p><br><strong>${idioma === \"es\" ? \"Imágenes de referencia:\" : \"Reference images:\"}</strong></p>${linksImagenes.join(\"\")}` \n  : \"\";\n\nconst parrafos = cuerpoLimpio\n  .split(/\\n{2,}/)\n  .map(p => `<p>${p.replace(/\\n/g, '<br>')}</p>`)\n  .join('');\n\nconst emailHtml = `<p>${saludo}</p>${parrafos}${seccionImagenes}<p><br>${despedida}</p><p><strong>${nombreFirma}</strong></p>`;\n\nreturn { json: { ...$json, email_body: emailHtml } };"
      },
